@prefix icr:     <https://icarium.io/ont/v1#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# ════════════════════════════════════════════════════════════════════════════
# Ontology Metadata
# ════════════════════════════════════════════════════════════════════════════

<https://icarium.io/ont/v1>
    a owl:Ontology ;
    owl:versionIRI <https://icarium.io/ont/v1> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "Icarium Hardware Verification Ontology"@en ;
    dcterms:description """A formal OWL 2 DL ontology for SystemVerilog/UVM hardware
verification knowledge graphs. Defines typed entities across four disjoint partitions
(structural, verification, coverage, register) and the cross-partition relationships
that enable graph-based reasoning over chip design verification data.

This is the first published OWL ontology to formally type UVM verification constructs
(uvm_agent, uvm_driver, uvm_monitor, uvm_scoreboard, uvm_sequencer, uvm_sequence,
uvm_sequence_item) and coverage constructs (covergroup, coverpoint, SVA assertion)
as distinct ontological classes with formal domain/range axioms."""@en ;
    dcterms:created "2026-05-21"^^xsd:date ;
    dcterms:subject "Hardware verification, SystemVerilog, UVM, chip design, knowledge graph"@en ;
    dcterms:rights "MIT License" ;
    vann:preferredNamespacePrefix "icr" ;
    vann:preferredNamespaceUri "https://icarium.io/ont/v1#" ;
    rdfs:seeAlso <https://github.com/icarium-io/icarium> ;
    rdfs:comment """Standard references used in this ontology:
  [UVM20]   IEEE Std 1800.2-2020 Universal Verification Methodology.
  [SV23]    IEEE Std 1800-2023 SystemVerilog Language Reference Manual.
  [IPXACT]  IEEE Std 1685-2022 IP-XACT Standard Structure for Packaging,
            Integrating, and Reusing IP within Tool Flows.
  [BT21]    Boutekkouk, F. (2021). Towards an Ontology-driven Intellectual
            Properties reuse for Systems On Chip design. IJCC 15:78-83."""@en .


# ════════════════════════════════════════════════════════════════════════════
# §1  Abstract Root
# ════════════════════════════════════════════════════════════════════════════

icr:HVEntity
    a owl:Class ;
    rdfs:label "Hardware Verification Entity"@en ;
    rdfs:comment """Abstract root class for all entities in the Icarium hardware
verification knowledge graph. Every individual is an instance of exactly one
concrete subclass. HVEntity is not intended to be instantiated directly."""@en .

# Common datatype properties shared by all HVEntity individuals
# (declared in §6; listed here for readability)

icr:name
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:string ;
    rdfs:label "name"@en ;
    rdfs:comment "The identifier as declared in source (module name, class name, etc.)."@en .

icr:sourceFile
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source file"@en ;
    rdfs:comment "Absolute path to the source file in which this entity is declared."@en .

icr:lineStart
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "line start"@en .

icr:lineEnd
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "line end"@en .

icr:confidence
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:float ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Extraction confidence in [0.0, 1.0]. Derived from model logits, parser certainty, or set to 1.0 for deterministic extraction."@en .

icr:confidenceSource
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:HVEntity ;
    rdfs:range xsd:string ;
    rdfs:label "confidence source"@en ;
    rdfs:comment "One of: ml_predicted, static_parsed, heuristic, explicit."@en .


# ════════════════════════════════════════════════════════════════════════════
# §2  Partition Classes (four disjoint branches under HVEntity)
# ════════════════════════════════════════════════════════════════════════════

icr:StructuralEntity
    a owl:Class ;
    rdfs:subClassOf icr:HVEntity ;
    rdfs:label "Structural Entity"@en ;
    rdfs:comment """RTL/design-level entity extracted from SystemVerilog source.
Aligned with IEEE 1800-2017 §23–26 structural constructs and IP-XACT IEEE 1685
component/port/busInterface data model.

DL: StructuralEntity ⊑ HVEntity"""@en .

icr:VerificationEntity
    a owl:Class ;
    rdfs:subClassOf icr:HVEntity ;
    rdfs:label "Verification Entity"@en ;
    rdfs:comment """UVM verification hierarchy entity. Covers uvm_component subclasses
(the instantiation topology) and uvm_object subclasses (data objects that flow through
the system). Aligned with IEEE 1800.2-2020 (UVM standard) [UVM20].

DL: VerificationEntity ⊑ HVEntity"""@en .

icr:CoverageEntity
    a owl:Class ;
    rdfs:subClassOf icr:HVEntity ;
    rdfs:label "Coverage Entity"@en ;
    rdfs:comment """Functional coverage and assertion entity. Covergroups, coverpoints,
and SVA assertions (concurrent and immediate). No prior published OWL ontology
formally types these constructs — this partition is an original contribution.

DL: CoverageEntity ⊑ HVEntity"""@en .

icr:RegisterEntity
    a owl:Class ;
    rdfs:subClassOf icr:HVEntity ;
    rdfs:label "Register Entity"@en ;
    rdfs:comment """Register model entity. Unifies the UVM RAL class hierarchy
(uvm_reg_block → uvm_reg_map → uvm_reg → uvm_reg_field) with the IP-XACT
memoryMap → addressBlock → register → field structure.

DL: RegisterEntity ⊑ HVEntity"""@en .

# Partition disjointness axiom (fundamental invariant of the ontology)
# DL: StructuralEntity ⊓ VerificationEntity ⊑ ⊥  (and all pairwise combinations)
[] a owl:AllDisjointClasses ;
    owl:members (
        icr:StructuralEntity
        icr:VerificationEntity
        icr:CoverageEntity
        icr:RegisterEntity
    ) .


# ════════════════════════════════════════════════════════════════════════════
# §3  Structural Partition — Entity Classes
# ════════════════════════════════════════════════════════════════════════════

icr:Module
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Module"@en ;
    rdfs:comment """A SystemVerilog module declaration (IEEE 1800-2017 §23).
Corresponds to IP-XACT component. The primary unit of RTL hierarchy.

DL: Module ⊑ StructuralEntity
    Module ⊑ ∀icr:instantiates.(Module ⊔ Interface)"""@en ;
    rdfs:seeAlso <https://ieeexplore.ieee.org/document/8299595> . # SV LRM

icr:Interface
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Interface"@en ;
    rdfs:comment """A SystemVerilog interface declaration (IEEE 1800-2017 §25).
Named bundle of nets, variables, tasks, and functions shared across module
boundaries. Corresponds to IP-XACT busDefinition/abstractionDefinition pair.
Used as the physical connection point between DUT and testbench.

DL: Interface ⊑ StructuralEntity"""@en .

icr:Port
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Port"@en ;
    rdfs:comment """A port declared on a Module or Interface (IEEE 1800-2017 §23.2).
Corresponds to IP-XACT wire port. A Modport is NOT a Port — it is a named
directional view of an Interface's existing Port set.

DL: Port ⊑ StructuralEntity
    Port ⊑ ∃icr:portOf.(Module ⊔ Interface)   (every port belongs to exactly one
                                                 module or interface)"""@en .

icr:Modport
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Modport"@en ;
    rdfs:comment """A named directional view of an Interface's port set (IEEE 1800-2017 §25.5).
Modports restrict which signals are accessible and in what direction for a
given connection. A driver specifying it drives via a particular modport is
a key cross-partition assertion about testbench topology.

DL: Modport ⊑ StructuralEntity
    Modport ⊑ ∃icr:modportOf.Interface   (every modport belongs to one interface)"""@en .

icr:Parameter
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Parameter"@en ;
    rdfs:comment """A parameter or localparam declaration on a Module or Interface.
Represents the declaration; resolved instance values are carried as properties
on the icr:instantiates relationship, not as separate Parameter individuals.
Corresponds to IP-XACT parameter element.

DL: Parameter ⊑ StructuralEntity
    Parameter ⊑ ∃icr:parameterOf.(Module ⊔ Interface)"""@en .

icr:Package
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Package"@en ;
    rdfs:comment """A SystemVerilog package declaration (IEEE 1800-2017 §26).
Provides a namespace for type definitions, parameters, functions, and tasks.
Cannot be instantiated; referenced via import declarations.

DL: Package ⊑ StructuralEntity"""@en .

icr:ClockDomain
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Clock Domain"@en ;
    rdfs:comment """An identified clock domain within the design. A clock domain
groups ports and modules that share a common clock source. Critical for
identifying clock domain crossings (CDCs) and scoping assertion properties.

DL: ClockDomain ⊑ StructuralEntity"""@en .

icr:ClockingBlock
    a owl:Class ;
    rdfs:subClassOf icr:StructuralEntity ;
    rdfs:label "Clocking Block"@en ;
    rdfs:comment """A SystemVerilog clocking block (IEEE 1800-2017 §14). Declared
inside a module or interface; defines a synchronous signal group with explicit
input skew (sampling) and output skew (driving). Central to testbench timing:
drivers use clocking blocks to synchronize stimulus with the DUT clock.

DL: ClockingBlock ⊑ StructuralEntity
    ClockingBlock ⊑ ∃icr:declaredIn.(Module ⊔ Interface)"""@en .

# ── Structural subclass disjointness ─────────────────────────────────────────
# (icr:Checker is in the Coverage partition; see §5)
[] a owl:AllDisjointClasses ;
    owl:members (
        icr:Module icr:Interface icr:Port icr:Modport
        icr:Parameter icr:Package icr:ClockDomain
        icr:ClockingBlock
    ) .


# ════════════════════════════════════════════════════════════════════════════
# §4  Verification Partition — Entity Classes
# ════════════════════════════════════════════════════════════════════════════

# Two internal abstract classes mirror the UVM class tree split

icr:UVMComponent
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "UVM Component"@en ;
    rdfs:comment """Abstract class for uvm_component subclasses [UVM20]. Components
form the persistent instantiation hierarchy built in build_phase and connected
in connect_phase. They model the structural topology of the testbench.
Distinguished from UVMObject (data objects) by persistent lifetime.

DL: UVMComponent ⊑ VerificationEntity"""@en .

icr:UVMObject
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "UVM Object"@en ;
    rdfs:comment """Abstract class for uvm_object subclasses that are NOT uvm_component [UVM20].
These are data objects — sequences and sequence items — that flow through the system
during simulation. Distinguished from UVMComponent by transient lifetime.

DL: UVMObject ⊑ VerificationEntity
    UVMComponent ⊓ UVMObject ⊑ ⊥   (disjoint)"""@en .

[] a owl:AllDisjointClasses ;
    owl:members ( icr:UVMComponent icr:UVMObject ) .

# UVM Component subclasses

icr:UVMTest
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Test"@en ;
    rdfs:comment """Extends uvm_test [UVM20]. Entry point for a test scenario.
Instantiates one or more UVMEnv instances in build_phase. Exactly one
UVMTest runs per simulation.

DL: UVMTest ⊑ UVMComponent
    UVMTest ⊑ ∃icr:instantiatesEnv.UVMEnv"""@en .

icr:UVMEnv
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Env"@en ;
    rdfs:comment """Extends uvm_env [UVM20]. Container for agents, sub-environments,
and scoreboards. May be hierarchically nested. The existential ∃contains.UVMAgent
is NOT asserted — top-level envs commonly contain only sub-envs and scoreboards.

DL: UVMEnv ⊑ UVMComponent"""@en .

icr:UVMAgent
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Agent"@en ;
    rdfs:comment """Extends uvm_agent [UVM20]. Encapsulates a protocol endpoint:
driver + sequencer (stimulus generation) and monitor (passive observation).
The is_active property determines whether driver and sequencer are created.
Passive agents contain only a monitor.

DL: UVMAgent ⊑ UVMComponent
    UVMAgent ⊑ ∃icr:contains.UVMMonitor"""@en .

icr:UVMDriver
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Driver"@en ;
    rdfs:comment """Extends uvm_driver#(REQ,RSP) [UVM20]. Pulls sequence items
from a UVMSequencer via seq_item_port (uvm_seq_item_pull_port) and drives
the DUT through a physical interface. Created only in active agents.

DL: UVMDriver ⊑ UVMComponent
    UVMDriver ⊑ ∃icr:pullsFrom.UVMSequencer
    UVMDriver ⊑ ∃icr:drives.(Interface ⊔ Port)"""@en .

icr:UVMMonitor
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Monitor"@en ;
    rdfs:comment """Extends uvm_monitor [UVM20]. Passively observes the DUT interface
without driving it. Broadcasts observed transactions to analysis subscribers
(scoreboards, coverage collectors) via uvm_analysis_port.

DL: UVMMonitor ⊑ UVMComponent
    UVMMonitor ⊑ ∃icr:monitors.Interface"""@en .

icr:UVMScoreboard
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Scoreboard"@en ;
    rdfs:comment """Extends uvm_scoreboard or uvm_subscriber [UVM20]. Receives
transactions from monitors via analysis connections (uvm_analysis_imp) and
checks functional correctness against a reference model.

DL: UVMScoreboard ⊑ UVMComponent"""@en .

icr:UVMSequencer
    a owl:Class ;
    rdfs:subClassOf icr:UVMComponent ;
    rdfs:label "UVM Sequencer"@en ;
    rdfs:comment """Extends uvm_sequencer#(REQ,RSP) [UVM20]. Arbitrates between
competing sequences and provides sequence items to the driver via
seq_item_export (the other end of the driver's seq_item_port connection).
NOTE: This entity type was absent from the original Icarium NER label set.
It is a first-class uvm_component and is required for correct graph topology.

DL: UVMSequencer ⊑ UVMComponent"""@en .

# UVM Object subclasses

icr:UVMSequence
    a owl:Class ;
    rdfs:subClassOf icr:UVMObject ;
    rdfs:label "UVM Sequence"@en ;
    rdfs:comment """Extends uvm_sequence#(REQ,RSP) [UVM20]. Generates stimulus
by creating and sending UVMSeqItem instances to a sequencer. A virtual
sequence contains no direct item generation but orchestrates other sequences
across multiple sequencers.

DL: UVMSequence ⊑ UVMObject
    UVMSequence ⊑ ∃icr:runsOn.UVMSequencer
(∃generates.UVMSeqItem is NOT a DL axiom — virtual sequences are exempt; see IC-10)"""@en .

icr:UVMSeqItem
    a owl:Class ;
    rdfs:subClassOf icr:UVMObject ;
    rdfs:label "UVM Sequence Item"@en ;
    rdfs:comment """Extends uvm_sequence_item [UVM20]. The atomic data object
exchanged between a sequence (generator) and a driver (consumer). Carries
randomizable stimulus fields (rand variables) governed by constraint blocks.

DL: UVMSeqItem ⊑ UVMObject"""@en .

icr:ConstraintBlock
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "Constraint Block"@en ;
    rdfs:comment """A named constraint block declared inside a uvm_sequence_item or
any randomizable class (IEEE 1800-2017 §18.5). Describes legal value ranges for
rand variables. Constraint blocks may be disabled per test or overridden via
constraint mode(). Linked from the owning class via icr:hasConstraint.

DL: ConstraintBlock ⊑ VerificationEntity"""@en .

icr:RandVar
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "Rand Variable"@en ;
    rdfs:comment """A rand or randc field declared in a randomizable class
(IEEE 1800-2017 §18.4). Carries stimulus data; constrained by ConstraintBlock
expressions. randc cycles through all values before repeating.

DL: RandVar ⊑ VerificationEntity"""@en .

icr:ConfigDbEntry
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "Config DB Entry"@en ;
    rdfs:comment """A typed entry set/retrieved through uvm_config_db [UVM20 §F.6].
The primary mechanism for distributing virtual interface handles from the
testbench top to UVM components. One individual per unique (scope, key) pair.
Relations: UVMComponent -[setsConfig]-> ConfigDbEntry, -[getsConfig]-> ConfigDbEntry.

DL: ConfigDbEntry ⊑ VerificationEntity"""@en .

icr:FactoryOverride
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "Factory Override"@en ;
    rdfs:comment """A type or instance override registered with the UVM factory
[UVM20 §F.5]. Enables test-level substitution of one component or object class
with another without modifying the environment. Declared in build_phase via
factory.set_type_override_by_type() or set_inst_override_by_name().
Relations: UVMTest -[declaresOverride]-> FactoryOverride.

DL: FactoryOverride ⊑ VerificationEntity"""@en .

icr:UVMEvent
    a owl:Class ;
    rdfs:subClassOf icr:VerificationEntity ;
    rdfs:label "UVM Event"@en ;
    rdfs:comment """A named synchronization event modelled in UVM, declared as a
uvm_event variable or retrieved from the global pool via
uvm_event_pool::get_global("name") [UVM20 §F.6].
UVMEvent nodes link components that trigger the event (PUBLISHES_TO edges)
with those that await it (PULLS_FROM edges), enabling cross-component
synchronisation topology to be queried without simulation traces.

DL: UVMEvent ⊑ VerificationEntity"""@en .

# ── Verification subclass disjointness ───────────────────────────────────────
[] a owl:AllDisjointClasses ;
    owl:members (
        icr:UVMTest icr:UVMEnv icr:UVMAgent icr:UVMDriver
        icr:UVMMonitor icr:UVMScoreboard icr:UVMSequencer
        icr:UVMSequence icr:UVMSeqItem
        icr:ConstraintBlock icr:RandVar icr:ConfigDbEntry icr:FactoryOverride
        icr:UVMEvent
    ) .


# ════════════════════════════════════════════════════════════════════════════
# §5  Coverage Partition — Entity Classes
# ════════════════════════════════════════════════════════════════════════════

icr:CoverGroup
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "Cover Group"@en ;
    rdfs:comment """A SystemVerilog covergroup declaration (IEEE 1800-2017 §19).
Functional coverage container. Triggered by a clocking event or sampling call.
May be instantiated multiple times; each instance tracks coverage independently.
Contains one or more coverpoints and optional cross constructs.

DL: CoverGroup ⊑ CoverageEntity
    CoverGroup ⊑ ∃icr:contains.CoverPoint"""@en .

icr:CoverPoint
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "Cover Point"@en ;
    rdfs:comment """A coverpoint within a covergroup (IEEE 1800-2017 §19.5).
Tracks coverage of a variable or expression across a set of bins (value ranges).
A cross construct relates two or more coverpoints — modeled as the
icr:crossesWith object property between CoverPoint individuals.

DL: CoverPoint ⊑ CoverageEntity
    CoverPoint ⊑ ∃icr:partOf.CoverGroup   (every coverpoint belongs to a covergroup)
    CoverPoint ⊑ ∀icr:partOf.CoverGroup"""@en .

icr:Assertion
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "Assertion"@en ;
    rdfs:comment """A SystemVerilog SVA concurrent assertion (assert property,
assume property, cover property, restrict property) or immediate assertion
(IEEE 1800-2017 §16). May be declared inline in RTL, inside a checker, or
attached to a module via the bind construct without modifying RTL source.

Assertion type taxonomy:
  assert property — specification of required behavior (falsifiable)
  assume property — constraint on environment inputs (for formal tools)
  cover property — coverage obligation (like a covergroup hit)
  restrict property — formal tool input constraint (not simulation)

DL: Assertion ⊑ CoverageEntity"""@en .

icr:Checker
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "Checker"@en ;
    rdfs:comment """A SystemVerilog checker declaration (IEEE 1800-2023 §17).
A named assertion container — semantically a coverage/verification construct,
not a hardware structural unit (hence in CoverageEntity, not StructuralEntity).
Checkers may contain procedural code, clocking declarations, and concurrent
assertion properties. Instantiated (not extended) and commonly attached to RTL
via the bind construct without modifying RTL source.

DL: Checker ⊑ CoverageEntity"""@en .

icr:SVAProperty
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "SVA Property"@en ;
    rdfs:comment """A named, reusable SystemVerilog Assertion property declaration
(property...endproperty) as defined in IEEE 1800-2023 §16.8.
Distinct from icr:Assertion, which models a property instantiation
(assert property, assume property, cover property). SVAProperty is the
*declaration*; Assertion is the *use* site.
Relations: Assertion -[referencesProperty]-> SVAProperty,
           SVAProperty -[referencesSequence]-> SVASequence.

DL: SVAProperty ⊑ CoverageEntity"""@en .

icr:SVASequence
    a owl:Class ;
    rdfs:subClassOf icr:CoverageEntity ;
    rdfs:label "SVA Sequence"@en ;
    rdfs:comment """A named, reusable SystemVerilog sequence declaration
(sequence...endsequence) as defined in IEEE 1800-2023 §16.7.
Models the *declaration* of a named temporal sequence expression; not to
be confused with icr:UVMSequence (a stimulus generator class).
Referenced by SVAProperty individuals via icr:referencesSequence.

DL: SVASequence ⊑ CoverageEntity"""@en .

# ── Coverage subclass disjointness ───────────────────────────────────────────
[] a owl:AllDisjointClasses ;
    owl:members ( icr:CoverGroup icr:CoverPoint icr:Assertion icr:Checker
                  icr:SVAProperty icr:SVASequence ) .


# ════════════════════════════════════════════════════════════════════════════
# §6  Register Partition — Entity Classes
# ════════════════════════════════════════════════════════════════════════════

icr:RegMap
    a owl:Class ;
    rdfs:subClassOf icr:RegisterEntity ;
    rdfs:label "Register Map"@en ;
    rdfs:comment """A uvm_reg_map [UVM20 §18.2.4]. An address map that defines
the byte offsets at which Registers in a RegBlock are accessible through a
specific bus interface. A RegBlock may have multiple RegMaps for different
bus interfaces (e.g., APB and AXI4-Lite). Each RegMap tracks the default
path (frontdoor/backdoor) for register access.
Relations: RegMap -[mapsRegister]-> Register.
Properties: baseAddress (hex), endian (big/little), busProtocol (string).

Without RegMap, multi-map address queries (e.g., "what is the APB offset of
register X?") cannot be answered in the knowledge graph.

DL: RegMap ⊑ RegisterEntity
    RegMap ⊑ ∃icr:mapsRegister.Register"""@en .

icr:RegBlock
    a owl:Class ;
    rdfs:subClassOf icr:RegisterEntity ;
    rdfs:label "Register Block"@en ;
    rdfs:comment """A uvm_reg_block [UVM20] or IP-XACT memoryMap/addressBlock.
Owns a set of registers and one or more address maps (uvm_reg_map). Blocks
may be hierarchically nested. The root block corresponds to the IP-XACT
top-level memoryMap.

DL: RegBlock ⊑ RegisterEntity
    RegBlock ⊑ ∃icr:contains.Register"""@en .

icr:Register
    a owl:Class ;
    rdfs:subClassOf icr:RegisterEntity ;
    rdfs:label "Register"@en ;
    rdfs:comment """A uvm_reg [UVM20] or IP-XACT register element. A single
addressable register with a fixed bit width, access policy, and reset value.
Contains one or more named fields.

DL: Register ⊑ RegisterEntity
    Register ⊑ ∃icr:contains.RegField
    Register ⊑ ∃icr:partOf.RegBlock"""@en .

icr:RegField
    a owl:Class ;
    rdfs:subClassOf icr:RegisterEntity ;
    rdfs:label "Register Field"@en ;
    rdfs:comment """A uvm_reg_field [UVM20] or IP-XACT field element. A named
contiguous bit range within a Register with its own access policy (RW, RO,
WO, W1C, RC, RS, WRC, W1S, etc.) and reset value. The access policy governs
both simulation behavior and formal verification assumptions.

DL: RegField ⊑ RegisterEntity
    RegField ⊑ ∃icr:partOf.Register
    RegField ⊑ ∀icr:partOf.Register"""@en .

# ── Register subclass disjointness ───────────────────────────────────────────
[] a owl:AllDisjointClasses ;
    owl:members ( icr:RegMap icr:RegBlock icr:Register icr:RegField ) .


# ════════════════════════════════════════════════════════════════════════════
# §7  Intra-Structural Object Properties
# ════════════════════════════════════════════════════════════════════════════

icr:instantiates
    a owl:ObjectProperty ;
    rdfs:domain icr:Module ;
    rdfs:range [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:label "instantiates"@en ;
    rdfs:comment """Module A instantiates Module B or Interface I (A contains an instance).
Corresponds to IP-XACT componentInstance. A single module/interface may be
instantiated multiple times; the relationship is N:M.
Properties on this edge: instanceName (string), paramBindings (JSON object)."""@en .

icr:hasPort
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:range icr:Port ;
    rdfs:label "has port"@en ;
    rdfs:comment "Module or Interface has a declared Port."@en .

icr:portOf
    a owl:ObjectProperty ;
    owl:inverseOf icr:hasPort ;
    rdfs:domain icr:Port ;
    rdfs:range [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:label "port of"@en .

icr:hasModport
    a owl:ObjectProperty ;
    rdfs:domain icr:Interface ;
    rdfs:range icr:Modport ;
    rdfs:label "has modport"@en ;
    rdfs:comment "Interface declares a named Modport (directional view of its port set)."@en .

icr:modportOf
    a owl:ObjectProperty ;
    owl:inverseOf icr:hasModport ;
    rdfs:domain icr:Modport ;
    rdfs:range icr:Interface ;
    rdfs:label "modport of"@en .

icr:hasParameter
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:range icr:Parameter ;
    rdfs:label "has parameter"@en .

icr:parameterOf
    a owl:ObjectProperty ;
    owl:inverseOf icr:hasParameter ;
    rdfs:domain icr:Parameter ;
    rdfs:range [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:label "parameter of"@en .

icr:usesPackage
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Module icr:Package ) ] ;
    rdfs:range icr:Package ;
    rdfs:label "uses package"@en ;
    rdfs:comment "Module or Package imports items from a Package (via import declaration)."@en .

icr:hasClockingBlock
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:range icr:ClockingBlock ;
    rdfs:label "has clocking block"@en .

icr:declaredIn
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:ClockingBlock icr:Checker ) ] ;
    rdfs:range [ owl:unionOf ( icr:Module icr:Interface ) ] ;
    rdfs:label "declared in"@en ;
    rdfs:comment "ClockingBlock or Checker is declared inside a Module or Interface scope."@en .

icr:inClockDomain
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Module icr:Port ) ] ;
    rdfs:range icr:ClockDomain ;
    rdfs:label "in clock domain"@en ;
    rdfs:comment "Module or Port belongs to an identified ClockDomain."@en .

icr:bridgesFromDomain
    a owl:ObjectProperty ;
    rdfs:domain icr:Module ;
    rdfs:range icr:ClockDomain ;
    rdfs:label "bridges from domain"@en ;
    rdfs:comment """The source clock domain of a CDC synchronizer module
(e.g., 2FF synchronizer, async FIFO). Used with isCDCSynchronizer=true."""@en .

icr:bridgesToDomain
    a owl:ObjectProperty ;
    rdfs:domain icr:Module ;
    rdfs:range icr:ClockDomain ;
    rdfs:label "bridges to domain"@en ;
    rdfs:comment "The destination clock domain of a CDC synchronizer module."@en .


# ════════════════════════════════════════════════════════════════════════════
# §8  Intra-Verification Object Properties
# ════════════════════════════════════════════════════════════════════════════

icr:contains
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMComponent ;
    rdfs:range icr:UVMComponent ;
    rdfs:label "contains"@en ;
    rdfs:comment """UVM component containment (build_phase instantiation).
Models the uvm_component parent-child tree:
  UVMTest → UVMEnv → UVMAgent → {UVMDriver, UVMMonitor, UVMSequencer}
Also used for CoverGroup → CoverPoint and RegBlock → Register containment."""@en .

icr:instantiatesEnv
    a owl:ObjectProperty ;
    rdfs:subPropertyOf icr:contains ;
    rdfs:domain icr:UVMTest ;
    rdfs:range icr:UVMEnv ;
    rdfs:label "instantiates env"@en .

icr:pullsFrom
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMDriver ;
    rdfs:range icr:UVMSequencer ;
    rdfs:label "pulls from"@en ;
    rdfs:comment """UVMDriver is connected to UVMSequencer via seq_item_port →
seq_item_export TLM connection (connect_phase). The driver pulls REQ items
and optionally returns RSP items."""@en .

icr:publishesTo
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMMonitor ;
    rdfs:range icr:UVMComponent ;
    rdfs:label "publishes to"@en ;
    rdfs:comment """UVMMonitor broadcasts observed transactions to any UVMComponent
subscriber (scoreboard, coverage collector, reference model) via
uvm_analysis_port → uvm_analysis_imp/uvm_analysis_export connection."""@en .

icr:generates
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range icr:UVMSeqItem ;
    rdfs:label "generates"@en ;
    rdfs:comment """UVMSequence creates, randomizes, and sends a UVMSeqItem to the driver
via the sequencer. The full protocol per IEEE 1800-2023/IEEE 1800.2-2020 §F.3 is:
  (1) create() — item is allocated (modelled as this edge);
  (2) start_item(req) — sequence blocks until the driver claims the item;
  (3) randomize() — fields are filled while the sequence holds the grant;
  (4) finish_item(req) — item is released to the driver; sequence blocks
      until the driver calls item_done().
Edge property: hasInlineConstraint (boolean) — true when randomize() carries
an inline with{} block. For the optional response path use icr:getsResponse."""@en .

icr:getsResponse
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range icr:UVMSeqItem ;
    rdfs:label "gets response"@en ;
    rdfs:comment """UVMSequence calls get_response(rsp) to receive the completed RSP item
returned by UVMDriver::put_response(). Models the return path of the
REQ/RSP handshake (IEEE 1800.2-2020 §F.3). Absence of this edge when the driver
declares a non-void RSP type indicates a dropped response (IC-22)."""@en .

icr:starts
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range icr:UVMSequence ;
    rdfs:label "starts"@en ;
    rdfs:comment """A virtual UVMSequence calls seq.start(sequencer) on a sub-sequence
(IEEE 1800-2023 / IEEE 1800.2-2020 §F.3). The edge enables reachability analysis:
given a root test sequence, which leaf sequences (and therefore which
item types and constraint blocks) are reachable?
Distinct from icr:generates (which links sequence → seq_item) and
icr:runsOn (which links sequence → sequencer).
DL: starts ⊆ UVMSequence × UVMSequence"""@en .

icr:runsOn
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range icr:UVMSequencer ;
    rdfs:label "runs on"@en ;
    rdfs:comment "UVMSequence is started on (arbitrated by) a UVMSequencer."@en .

icr:extends
    a owl:ObjectProperty ;
    rdfs:domain icr:VerificationEntity ;
    rdfs:range icr:VerificationEntity ;
    rdfs:label "extends"@en ;
    rdfs:comment """OOP class inheritance within the UVM class hierarchy.
Distinct from the component containment modeled by icr:contains.
A user-defined my_driver extends uvm_driver.
Transitive; not functional (single inheritance in SV)."""@en ;
    a owl:TransitiveProperty .

icr:hasVirtualIf
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMComponent ;
    rdfs:range icr:Interface ;
    rdfs:label "has virtual if"@en ;
    rdfs:comment """A UVMComponent holds a virtual interface handle to the given
Interface. This is the physical access path for drivers and monitors (distinct
from the semantic icr:drives / icr:monitors edges). Typically obtained via
uvm_config_db::get(). Edge property: configDbKey (string)."""@en .

icr:hasConstraint
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMSeqItem icr:UVMSequence ) ] ;
    rdfs:range icr:ConstraintBlock ;
    rdfs:label "has constraint"@en ;
    rdfs:comment """A randomizable SV object declares a named ConstraintBlock
(IEEE 1800-2023 §18.5). Domain is UVMSeqItem ⊔ UVMSequence because
sequences are also SV objects and frequently carry rand fields — e.g.,
a burst-count rand variable constrained to legal transfer sizes."""@en .

icr:hasRandVar
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMSeqItem icr:UVMSequence ) ] ;
    rdfs:range icr:RandVar ;
    rdfs:label "has rand var"@en ;
    rdfs:comment """A randomizable SV object declares a rand or randc member variable
(IEEE 1800-2023 §18.4). Domain is UVMSeqItem ⊔ UVMSequence for the
same reason as icr:hasConstraint."""@en .

icr:declaresOverride
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMTest ;
    rdfs:range icr:FactoryOverride ;
    rdfs:label "declares override"@en ;
    rdfs:comment "A UVMTest registers a factory override during build_phase."@en .

icr:setsConfig
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMComponent ;
    rdfs:range icr:ConfigDbEntry ;
    rdfs:label "sets config"@en ;
    rdfs:comment "A UVMComponent writes a value into the uvm_config_db."@en .

icr:getsConfig
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMComponent ;
    rdfs:range icr:ConfigDbEntry ;
    rdfs:label "gets config"@en ;
    rdfs:comment "A UVMComponent reads a value from the uvm_config_db."@en .

icr:overridesConstraint
    a owl:ObjectProperty ;
    rdfs:domain icr:ConstraintBlock ;
    rdfs:range icr:ConstraintBlock ;
    rdfs:label "overrides constraint"@en ;
    rdfs:comment """A ConstraintBlock in a derived class overrides a same-named ConstraintBlock
in a base class (IEEE 1800-2023 §18.5.1). The derived constraint completely replaces
the base; the base constraint becomes inactive for instances of the derived class.
This makes the base constraint a shadow — it is parsed and KG-indexed but never
evaluated during randomization of derived-class objects."""@en .

icr:disablesConstraint
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMSequence icr:UVMTest icr:UVMComponent ) ] ;
    rdfs:range icr:ConstraintBlock ;
    rdfs:label "disables constraint"@en ;
    rdfs:comment """The source entity calls constraint_mode(0) on the target ConstraintBlock
before invoking randomize() (IEEE 1800-2023 §18.9). The constraint is inactive at
that call site; re-enabling via constraint_mode(1) should be modelled as a separate
edge if present. Inline constraints (isInline=true) cannot be disabled this way."""@en .

icr:randomizes
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMSequence icr:UVMTest icr:UVMComponent ) ] ;
    rdfs:range [ owl:unionOf ( icr:UVMSeqItem icr:UVMSequence ) ] ;
    rdfs:label "randomizes"@en ;
    rdfs:comment """The source entity calls .randomize() (or DV_CHECK_RANDOMIZE_WITH_FATAL)
on the target object. Tracks the call site — which is distinct from where the item is
later driven via start_item/finish_item. Edge property: hasInlineConstraint (boolean)
— true when the call is randomize() with { ... } adding ad-hoc constraints."""@en .


# ════════════════════════════════════════════════════════════════════════════
# §9  Intra-Coverage Object Properties
# ════════════════════════════════════════════════════════════════════════════

icr:partOf
    a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Mereological parthood. Used for: CoverPoint ⊂ CoverGroup, RegField ⊂ Register, Register ⊂ RegBlock."@en .

icr:crossesWith
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range icr:CoverPoint ;
    rdfs:label "crosses with"@en ;
    rdfs:comment """Cross coverage between two CoverPoints within the same CoverGroup
(IEEE 1800-2023 §19.10). Symmetric: if A crosses B then B crosses A."""@en .

icr:referencesProperty
    a owl:ObjectProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range icr:SVAProperty ;
    rdfs:label "references property"@en ;
    rdfs:comment """A concurrent SVA instantiation (Assertion) references the named
SVAProperty it instantiates (e.g., assert property(foo_p) references the
'foo_p' SVAProperty declaration). Required for IC-13 (assertion clock
traceability) and cross-partition reasoning over property reuse."""@en .

icr:referencesSequence
    a owl:ObjectProperty ;
    rdfs:domain icr:SVAProperty ;
    rdfs:range icr:SVASequence ;
    rdfs:label "references sequence"@en ;
    rdfs:comment "An SVAProperty body references a named SVASequence expression."@en .


# ════════════════════════════════════════════════════════════════════════════
# §10  Cross-Partition Object Properties (the reasoning edges)
# ════════════════════════════════════════════════════════════════════════════

icr:drives
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMDriver ;
    rdfs:range [ owl:unionOf ( icr:Interface icr:Port ) ] ;
    rdfs:label "drives"@en ;
    rdfs:comment """A UVMDriver drives a physical Interface or Port of the DUT.
This is the primary cross-partition edge connecting the verification partition
to the structural partition. Properties on this edge: viaModport (string —
the modport name if the driver connects through a specific modport)."""@en .

icr:monitors
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMMonitor ;
    rdfs:range [ owl:unionOf ( icr:Interface icr:Port ) ] ;
    rdfs:label "monitors"@en ;
    rdfs:comment """A UVMMonitor passively observes an Interface or Port of the DUT.
Properties on this edge: viaModport (string)."""@en .

icr:tests
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMAgent ;
    rdfs:range icr:Module ;
    rdfs:label "tests"@en ;
    rdfs:comment "A UVMAgent is responsible for verifying a specific DUT Module."@en .

icr:checks
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Assertion icr:UVMScoreboard ) ] ;
    rdfs:range icr:Module ;
    rdfs:label "checks"@en ;
    rdfs:comment "An Assertion or Scoreboard checks the behavior of a DUT Module."@en .

icr:covers
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:CoverGroup icr:CoverPoint ) ] ;
    rdfs:range [ owl:unionOf ( icr:Module icr:Port ) ] ;
    rdfs:label "covers"@en ;
    rdfs:comment "A CoverGroup or CoverPoint samples coverage of a Module or Port signal."@en .

icr:references
    a owl:ObjectProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range [ owl:unionOf ( icr:Port icr:Module ) ] ;
    rdfs:label "references"@en ;
    rdfs:comment "An Assertion expression references a Port signal or Module scope."@en .

icr:boundTo
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:Assertion icr:Checker ) ] ;
    rdfs:range icr:Module ;
    rdfs:label "bound to"@en ;
    rdfs:comment """An Assertion or Checker is attached to a Module via the SV bind
construct (IEEE 1800-2017 §23.11) without modifying the RTL source.
Properties: bindTarget — 'type' (all instances) or 'instance' (one instance),
bindTargetPath (string) for instance-scoped binds."""@en .

icr:stimulates
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range icr:Module ;
    rdfs:label "stimulates"@en ;
    rdfs:comment "A UVMSequence targets (generates stimulus for) a specific DUT Module."@en .

icr:callsBfm
    a owl:ObjectProperty ;
    rdfs:domain icr:UVMDriver ;
    rdfs:range icr:Module ;
    rdfs:label "calls BFM"@en ;
    rdfs:comment """A UVMDriver delegates signal driving to a BFM (Bus Functional Model)
Module. Used when the BFM is implemented as a SystemVerilog module with a task-based
interface rather than as a clocking-block driver. The range Module should have
moduleRole = 'bfm'."""@en .

icr:abstracts
    a owl:ObjectProperty ;
    rdfs:domain icr:RegBlock ;
    rdfs:range icr:Module ;
    rdfs:label "abstracts"@en ;
    rdfs:comment """A UVM Register Block (uvm_reg_block) is the software model for
a hardware register file implemented in a Module. Corresponds to the
UVM RAL adapter pattern."""@en .

icr:mapsTo
    a owl:ObjectProperty ;
    rdfs:domain icr:Register ;
    rdfs:range icr:Port ;
    rdfs:label "maps to"@en ;
    rdfs:comment """A Register in the register model maps to a physical bus Port
(e.g., an APB or AXI-Lite slave port) through which it is accessed."""@en .

icr:mapsRegister
    a owl:ObjectProperty ;
    rdfs:domain icr:RegMap ;
    rdfs:range icr:Register ;
    rdfs:label "maps register"@en ;
    rdfs:comment """A RegMap makes a Register accessible at a specific byte offset.
Edge property: offset (hex string, e.g. '0x04').
Corresponds to uvm_reg_map::add_reg() [UVM20 §18.2.4]."""@en .

icr:samples
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMComponent icr:UVMSequence icr:Module ) ] ;
    rdfs:range icr:CoverGroup ;
    rdfs:label "samples"@en ;
    rdfs:comment """The source explicitly calls cg_inst.sample() to collect coverage
on the target CoverGroup (IEEE 1800-2023 §19.8.1). Distinct from automatic
clocking-event sampling (samplingMechanism='clocking_event'), where no call site
exists. A CoverGroup with samplingMechanism='explicit_call' and no incoming SAMPLES
edge is a zombie — it will never collect data (IC-19).
Edge property: samplingContext (string — the task/function/phase in which
sample() is called, e.g. 'write()', 'body()', 'check_phase()')."""@en .

icr:instantiatesCg
    a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMComponent icr:Module ) ] ;
    rdfs:range icr:CoverGroup ;
    rdfs:label "instantiates CG"@en ;
    rdfs:comment """A UVMComponent or RTL Module holds and constructs a CoverGroup
instance (the new() call that creates the runtime instance). Distinct from the
CoverGroup type declaration (which may be in a package). A single CoverGroup type
may be instantiated in multiple components, yielding multiple independent instances
each accumulating separate coverage bins."""@en .


# ════════════════════════════════════════════════════════════════════════════
# §11  Datatype Properties — Structural Partition
# ════════════════════════════════════════════════════════════════════════════

icr:abstractionLevel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Module ;
    rdfs:range xsd:string ;
    rdfs:label "abstraction level"@en ;
    rdfs:comment "One of: RTL, TL (transaction-level), behavioral, gate."@en .

icr:isTopModule
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Module ;
    rdfs:range xsd:boolean ;
    rdfs:label "is top module"@en .

icr:moduleRole
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Module ;
    rdfs:range xsd:string ;
    rdfs:label "module role"@en ;
    rdfs:comment "Functional role: rtl | wrapper | stub | bfm | testbench_top."@en .

icr:defaultTest
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Module ;
    rdfs:range xsd:string ;
    rdfs:label "default test"@en ;
    rdfs:comment "Test name string passed to run_test() in a testbench_top module."@en .

icr:isCDCSynchronizer
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Module ;
    rdfs:range xsd:boolean ;
    rdfs:label "is CDC synchronizer"@en ;
    rdfs:comment "True if this module is a clock domain crossing synchronizer (2FF, async FIFO, MCP)."@en .

icr:portDirection
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:string ;
    rdfs:label "port direction"@en ;
    rdfs:comment "One of: input, output, inout, ref (IEEE 1800-2017 §23.2)."@en .

icr:widthBits
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "width bits"@en ;
    rdfs:comment "Resolved bit width of the port after parameter substitution."@en .

icr:dataType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:string ;
    rdfs:label "data type"@en ;
    rdfs:comment "SV data type string: logic, wire, reg, or a typedef name."@en .

icr:isClock
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:boolean ;
    rdfs:label "is clock"@en .

icr:isReset
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:boolean ;
    rdfs:label "is reset"@en .

icr:isActiveLow
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Port ;
    rdfs:range xsd:boolean ;
    rdfs:label "is active low"@en ;
    rdfs:comment "True for active-low resets or enables."@en .

icr:defaultValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Parameter ;
    rdfs:range xsd:string ;
    rdfs:label "default value"@en .

icr:isLocalparam
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Parameter ;
    rdfs:range xsd:boolean ;
    rdfs:label "is localparam"@en .

icr:protocol
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Interface ;
    rdfs:range xsd:string ;
    rdfs:label "protocol"@en ;
    rdfs:comment "Bus protocol this interface implements, e.g. AXI4, APB3, AHB-Lite, custom."@en .

icr:clockSignal
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ClockingBlock ;
    rdfs:range xsd:string ;
    rdfs:label "clock signal"@en .

icr:inputSkew
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ClockingBlock ;
    rdfs:range xsd:string ;
    rdfs:label "input skew"@en ;
    rdfs:comment "Input sampling skew, e.g. '1step' (IEEE 1800-2017 §14.4)."@en .

icr:outputSkew
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ClockingBlock ;
    rdfs:range xsd:string ;
    rdfs:label "output skew"@en ;
    rdfs:comment "Output driving skew, e.g. '#2ns' (IEEE 1800-2017 §14.4)."@en .

icr:freqMHz
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ClockDomain ;
    rdfs:range xsd:float ;
    rdfs:label "frequency MHz"@en .


# ════════════════════════════════════════════════════════════════════════════
# §12  Datatype Properties — Verification Partition
# ════════════════════════════════════════════════════════════════════════════

icr:className
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:VerificationEntity ;
    rdfs:range xsd:string ;
    rdfs:label "class name"@en ;
    rdfs:comment "Fully qualified SystemVerilog class name."@en .

icr:extendsClass
    a owl:DatatypeProperty ;
    rdfs:domain icr:VerificationEntity ;
    rdfs:range xsd:string ;
    rdfs:label "extends class"@en ;
    rdfs:comment "Immediate parent class name (string; use icr:extends for typed link)."@en .

icr:isActive
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:UVMAgent ;
    rdfs:range xsd:string ;
    rdfs:label "is active"@en ;
    rdfs:comment "One of: active, passive. Determines whether driver and sequencer are created."@en .

icr:reqType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ owl:unionOf ( icr:UVMDriver icr:UVMSequencer icr:UVMSequence ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "REQ type"@en ;
    rdfs:comment "The sequence item type (REQ parameter) for parameterized UVM classes."@en .

icr:rspType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:UVMDriver ;
    rdfs:range xsd:string ;
    rdfs:label "RSP type"@en .

icr:isVirtualSequence
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:UVMSequence ;
    rdfs:range xsd:boolean ;
    rdfs:label "is virtual sequence"@en ;
    rdfs:comment "True if this sequence orchestrates sub-sequences across multiple sequencers (UVM coordination pattern; unrelated to SV virtual keyword or virtual interface)."@en .

icr:registeredTestName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:UVMTest ;
    rdfs:range xsd:string ;
    rdfs:label "registered test name"@en ;
    rdfs:comment "String name passed to `uvm_component_utils macro for factory registration."@en .

icr:arbitrationMode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:UVMSequencer ;
    rdfs:range xsd:string ;
    rdfs:label "arbitration mode"@en ;
    rdfs:comment "One of: SEQ_ARB_FIFO, SEQ_ARB_WEIGHTED, SEQ_ARB_RANDOM, SEQ_ARB_STRICT_FIFO, SEQ_ARB_USER [UVM20]."@en .

# ── ConstraintBlock datatype properties ──────────────────────────────────────

icr:ownerClass
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConstraintBlock ;
    rdfs:range xsd:string ;
    rdfs:label "owner class"@en ;
    rdfs:comment "Class name that declares this constraint block."@en .

icr:isSoft
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConstraintBlock ;
    rdfs:range xsd:boolean ;
    rdfs:label "is soft"@en ;
    rdfs:comment "True if declared 'soft' (lower priority, overridable by derived class constraints)."@en .

icr:isInline
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConstraintBlock ;
    rdfs:range xsd:boolean ;
    rdfs:label "is inline"@en ;
    rdfs:comment """True if this constraint is an ad-hoc randomize() with { ... } inline block
rather than a named constraint block. Inline constraints cannot be disabled via
constraint_mode() and always take effect at the randomize call site (IEEE 1800-2023 §18.12).
DISABLES_CONSTRAINT edges must not target inline ConstraintBlock individuals."""@en .

icr:constraintMode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConstraintBlock ;
    rdfs:range xsd:string ;
    rdfs:label "constraint mode"@en ;
    rdfs:comment """Default activation mode at declaration time: 'hard' (cannot be violated,
default) or 'soft' (lower priority, can be overridden by a derived-class hard constraint
on the same variable — IEEE 1800-2023 §18.5.1). Does not track runtime constraint_mode()
calls; use DISABLES_CONSTRAINT edges for dynamic disabling."""@en .

# ── RandVar datatype properties ───────────────────────────────────────────────

icr:varName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RandVar ;
    rdfs:range xsd:string ;
    rdfs:label "var name"@en ;
    rdfs:comment "Field name as declared in the class."@en .

icr:isRandc
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RandVar ;
    rdfs:range xsd:boolean ;
    rdfs:label "is randc"@en ;
    rdfs:comment "True if randc (cyclic random), false if rand."@en .

# ── ConfigDbEntry datatype properties ─────────────────────────────────────────

icr:configScope
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConfigDbEntry ;
    rdfs:range xsd:string ;
    rdfs:label "config scope"@en ;
    rdfs:comment "UVM component path scope, e.g. 'uvm_test_top.env.agent'."@en .

icr:configKey
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConfigDbEntry ;
    rdfs:range xsd:string ;
    rdfs:label "config key"@en ;
    rdfs:comment "Key string used in uvm_config_db::set/get."@en .

icr:valueType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:ConfigDbEntry ;
    rdfs:range xsd:string ;
    rdfs:label "value type"@en ;
    rdfs:comment "SV type string of the stored value, e.g. 'virtual axi_if', 'int'."@en .

# ── FactoryOverride datatype properties ───────────────────────────────────────

icr:overrideScope
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:FactoryOverride ;
    rdfs:range xsd:string ;
    rdfs:label "override scope"@en ;
    rdfs:comment "One of: type (all instances), instance (one hierarchical path)."@en .

icr:instancePath
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:FactoryOverride ;
    rdfs:range xsd:string ;
    rdfs:label "instance path"@en ;
    rdfs:comment "Hierarchical component path for instance-scoped overrides."@en .

icr:originalClass
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:FactoryOverride ;
    rdfs:range xsd:string ;
    rdfs:label "original class"@en ;
    rdfs:comment "Base class being overridden."@en .

icr:substituteClass
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:FactoryOverride ;
    rdfs:range xsd:string ;
    rdfs:label "substitute class"@en ;
    rdfs:comment "Replacement class registered with the factory."@en .


# ════════════════════════════════════════════════════════════════════════════
# §13  Datatype Properties — Coverage Partition
# ════════════════════════════════════════════════════════════════════════════

icr:triggerEvent
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverGroup ;
    rdfs:range xsd:string ;
    rdfs:label "trigger event"@en ;
    rdfs:comment "The clocking event or explicit sample() call that triggers coverage sampling."@en .

icr:nCoverpoints
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverGroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "n coverpoints"@en .

icr:samplingMechanism
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverGroup ;
    rdfs:range xsd:string ;
    rdfs:label "sampling mechanism"@en ;
    rdfs:comment """How the covergroup is sampled: 'clocking_event' (automatic, triggered
by @(event) in the covergroup declaration — always-on), 'explicit_call' (requires
an explicit .sample() call from a component or sequence — must have a SAMPLES edge,
enforced by IC-19), or 'embedded' (sampled inline in RTL without a separate call,
e.g. RTL-internal covergroups) [IEEE 1800-2023 §19.8]."""@en .

icr:declaringClass
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverGroup ;
    rdfs:range xsd:string ;
    rdfs:label "declaring class"@en ;
    rdfs:comment """The class or module name in which this covergroup type is declared.
May differ from the instantiating class when the covergroup type is defined in a
package and instantiated in multiple components (each creating an independent instance
via INSTANTIATES_CG). Enables queries like 'find all instantiations of coverage_pkg::err_cg'."""@en .

icr:isBoundCg
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverGroup ;
    rdfs:range xsd:boolean ;
    rdfs:label "is bound CG"@en ;
    rdfs:comment """True if this covergroup is attached to RTL via the SV bind construct
rather than being directly instantiated inside a module or UVM component. Bound
covergroups are in the coverage partition but their sampling depends on the target
RTL module's signal activity, not on an explicit sample() call."""@en .

icr:variableRef
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:string ;
    rdfs:label "variable ref"@en ;
    rdfs:comment "The variable or expression being tracked by this coverpoint."@en .

icr:nBins
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "n bins"@en .

icr:optionWeight
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "option weight"@en ;
    rdfs:comment "Relative weight of this coverpoint in CoverGroup total (default 1) [IEEE 1800-2017 §19.7]."@en .

icr:optionAtLeast
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "option at least"@en ;
    rdfs:comment "Minimum number of hits required per bin to count as covered (default 1)."@en .

icr:optionAutoBinMax
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "option auto bin max"@en ;
    rdfs:comment "Maximum number of automatically generated bins (default 64)."@en .

icr:hasBins
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:CoverPoint ;
    rdfs:range xsd:boolean ;
    rdfs:label "has bins"@en ;
    rdfs:comment "True if this coverpoint declares explicit bins (rather than relying on auto-binning)."@en .

icr:assertionType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range xsd:string ;
    rdfs:label "assertion type"@en ;
    rdfs:comment "One of: assert, assume, cover, restrict (IEEE 1800-2017 §16)."@en .

icr:isConcurrent
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range xsd:boolean ;
    rdfs:label "is concurrent"@en ;
    rdfs:comment "True if this is a concurrent SVA assertion (assert property, temporal); false if immediate (assert, procedural) [IEEE 1800-2017 §16]."@en .

icr:isBound
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range xsd:boolean ;
    rdfs:label "is bound"@en ;
    rdfs:comment "True if this assertion is instantiated via the SV bind construct."@en .

icr:clockExpr
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range xsd:string ;
    rdfs:label "clock expr"@en ;
    rdfs:comment "The default clocking or @(posedge clk) expression for this assertion."@en .

icr:disableIff
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Assertion ;
    rdfs:range xsd:string ;
    rdfs:label "disable iff"@en ;
    rdfs:comment "The reset/disable condition expression for this concurrent assertion."@en .

# ── SVAProperty / SVASequence datatype properties ─────────────────────────────

icr:propertyBody
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:SVAProperty ;
    rdfs:range xsd:string ;
    rdfs:label "property body"@en ;
    rdfs:comment "Source text of the property body (for traceability and display)."@en .

icr:sequenceBody
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:SVASequence ;
    rdfs:range xsd:string ;
    rdfs:label "sequence body"@en ;
    rdfs:comment "Source text of the sequence body (for traceability and display)."@en .


# ════════════════════════════════════════════════════════════════════════════
# §14  Datatype Properties — Register Partition
# ════════════════════════════════════════════════════════════════════════════

icr:baseAddress
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ owl:unionOf ( icr:RegBlock icr:RegMap ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "base address"@en ;
    rdfs:comment "Hex string base address of the register block or map, e.g. '0x0000_4000'."@en .

icr:addressOffset
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Register ;
    rdfs:range xsd:string ;
    rdfs:label "address offset"@en ;
    rdfs:comment "Hex string byte offset of this register from block base address."@en .

icr:registerWidth
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:Register ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "register width"@en ;
    rdfs:comment "Total bit width of the register."@en .

icr:accessPolicy
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ owl:unionOf ( icr:Register icr:RegField ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "access policy"@en ;
    rdfs:comment "One of: RW, RO, WO, W1C, RC, RS, WRC, W1S, W0C, W0S, W1T, W0T (UVM RAL + IP-XACT)."@en .

icr:resetValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ owl:unionOf ( icr:Register icr:RegField ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "reset value"@en ;
    rdfs:comment "Hex string reset value."@en .

icr:lsb
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RegField ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "LSB"@en .

icr:msb
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RegField ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "MSB"@en .

# ── RegMap datatype properties ────────────────────────────────────────────────

icr:endian
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RegMap ;
    rdfs:range xsd:string ;
    rdfs:label "endian"@en ;
    rdfs:comment "Byte ordering: 'big' or 'little'. Governs byte-lane assignment on the bus."@en .

icr:busProtocol
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain icr:RegMap ;
    rdfs:range xsd:string ;
    rdfs:label "bus protocol"@en ;
    rdfs:comment "Bus protocol through which this map is accessed, e.g. APB, AXI4-Lite, AHB-Lite."@en .


# ════════════════════════════════════════════════════════════════════════════
# §15  Formal OWL 2 DL Class Restrictions
#
# These encode the DL axioms documented in §2–§6 comments as actual
# owl:Restriction anonymous class expressions, enabling reasoner verification.
# None of these involve the transitive icr:extends property, so all are
# safe for OWL 2 DL (no undecidability risk from role chains).
# ════════════════════════════════════════════════════════════════════════════

# ── Structural partition ──────────────────────────────────────────────────────

icr:Port rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:portOf ;
      owl:someValuesFrom [ owl:unionOf ( icr:Module icr:Interface ) ] ] .

icr:Modport rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:modportOf ;
      owl:someValuesFrom icr:Interface ] .

icr:ClockingBlock rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:declaredIn ;
      owl:someValuesFrom [ owl:unionOf ( icr:Module icr:Interface ) ] ] .

icr:Module rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:instantiates ;
      owl:allValuesFrom [ owl:unionOf ( icr:Module icr:Interface ) ] ] .

# ── Verification partition ────────────────────────────────────────────────────

icr:UVMTest rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:instantiatesEnv ;
      owl:someValuesFrom icr:UVMEnv ] .

icr:UVMAgent rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:contains ;
      owl:someValuesFrom icr:UVMMonitor ] .

icr:UVMDriver rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:pullsFrom ;
      owl:someValuesFrom icr:UVMSequencer ] ,
    [ a owl:Restriction ; owl:onProperty icr:drives ;
      owl:someValuesFrom [ owl:unionOf ( icr:Interface icr:Port ) ] ] .

icr:UVMMonitor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:monitors ;
      owl:someValuesFrom [ owl:unionOf ( icr:Interface icr:Port ) ] ] .

icr:UVMSequence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:runsOn ;
      owl:someValuesFrom icr:UVMSequencer ] .

# ── Coverage partition ────────────────────────────────────────────────────────

icr:CoverGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty [ owl:inverseOf icr:partOf ] ;
      owl:someValuesFrom icr:CoverPoint ] .

icr:CoverPoint rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:partOf ;
      owl:someValuesFrom icr:CoverGroup ] ,
    [ a owl:Restriction ; owl:onProperty icr:partOf ;
      owl:allValuesFrom icr:CoverGroup ] .

# ── Register partition ────────────────────────────────────────────────────────

icr:RegBlock rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty [ owl:inverseOf icr:partOf ] ;
      owl:someValuesFrom icr:Register ] .

icr:Register rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty [ owl:inverseOf icr:partOf ] ;
      owl:someValuesFrom icr:RegField ] .

icr:RegField rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:partOf ;
      owl:someValuesFrom icr:Register ] ,
    [ a owl:Restriction ; owl:onProperty icr:partOf ;
      owl:allValuesFrom icr:Register ] .

# ── partOf domain/range (P11 fix) ─────────────────────────────────────────────
# icr:partOf is used in two disjoint contexts:
#   CoverPoint partOf CoverGroup   (coverage partition)
#   RegField   partOf Register     (register partition)
#   Register   partOf RegBlock     (register partition, optional)
# Domain/range cover all valid uses.

icr:partOf
    rdfs:domain [ owl:unionOf ( icr:CoverPoint icr:RegField icr:Register ) ] ;
    rdfs:range  [ owl:unionOf ( icr:CoverGroup icr:Register icr:RegBlock ) ] .

# ── SVA declaration types ─────────────────────────────────────────────────────

icr:Assertion rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:referencesProperty ;
      owl:allValuesFrom icr:SVAProperty ] .

icr:SVAProperty rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:referencesSequence ;
      owl:allValuesFrom icr:SVASequence ] .

# ── Coverage lifecycle (range declarations for IC-19/IC-20 support) ───────────

icr:samples rdfs:range icr:CoverGroup .
icr:instantiatesCg rdfs:range icr:CoverGroup .

# ── RegMap ────────────────────────────────────────────────────────────────────

icr:RegMap rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty icr:mapsRegister ;
      owl:someValuesFrom icr:Register ] ,
    [ a owl:Restriction ; owl:onProperty icr:mapsRegister ;
      owl:allValuesFrom icr:Register ] .

# ════════════════════════════════════════════════════════════════════════════
# §17  Integrity Constraints (SPARQL-checkable; some OWL 2 DL-expressible)
# ════════════════════════════════════════════════════════════════════════════
#
# IC-1, IC-2–IC-5, IC-7, IC-8, IC-10, IC-11, IC-14, IC-15–IC-21
# require closed-world reasoning and are enforced by ingestion-layer validation.
# IC-14 specifically: absence of a clockExpr triple cannot be asserted by
# owl:Restriction under the Open World Assumption; it requires closed-world
# evaluation (owl:maxCardinality(0) with CWA) at ingestion time.
# IC-12, IC-13 are OWL 2 DL-expressible as owl:Restriction axioms; see §15.
# IC-6, IC-9, IC-17 use xsd datatype facets (value range, not cardinality).
#
# IC-1:  Every UVMDriver must have at least one icr:pullsFrom triple.
#         ∀d ∈ UVMDriver: |{s : pullsFrom(d,s)}| ≥ 1
#
# IC-2:  Every UVMDriver must have at least one icr:drives triple.
#         ∀d ∈ UVMDriver: |{i : drives(d,i)}| ≥ 1
#
# IC-3:  Every UVMMonitor must have at least one icr:monitors triple.
#         ∀m ∈ UVMMonitor: |{i : monitors(m,i)}| ≥ 1
#
# IC-4:  Every CoverPoint must have exactly one icr:partOf triple to a CoverGroup.
#         ∀cp ∈ CoverPoint: ∃!cg ∈ CoverGroup: partOf(cp,cg)
#
# IC-5:  Every RegField must have exactly one icr:partOf triple to a Register.
#         ∀f ∈ RegField: ∃!r ∈ Register: partOf(f,r)
#
# IC-6:  icr:confidence ∈ [0.0, 1.0].
#         (OWL 2 DL: xsd:minInclusive 0.0, xsd:maxInclusive 1.0)
#
# IC-7:  If UVMAgent.isActive = "active" then it must contain a UVMDriver
#         and a UVMSequencer. (SPARQL rule)
#
# IC-8:  Every RegField: lsb ≤ msb. (SPARQL rule)
#
# IC-9:  icr:portDirection ∈ {input, output, inout, ref}. (OWL oneOf range)
#
# IC-10: Non-virtual UVMSequence must generate at least one UVMSeqItem.
#         ∀s: isVirtualSequence(s)=false → ∃i ∈ UVMSeqItem: generates(s,i)
#         (SPARQL rule; virtual sequences exempt)
#
# IC-11: reqType of a Driver, Sequencer, or Sequence must match their
#         shared UVMSeqItem kind string. (SPARQL rule)
#
# IC-12: A passive UVMAgent (isActive="passive") must have no icr:contains
#         triple to a UVMDriver individual. (OWL 2 DL via allValuesFrom;
#         encoded in §15 via closed-world SPARQL in practice)
#
# IC-13: A concurrent Assertion (isConcurrent=true) that icr:referencesProperty
#         an SVAProperty must inherit a non-empty clockExpr.
#         (SPARQL rule; verifiable via join with SVAProperty.propertyBody)
#
# IC-14: An immediate Assertion (isConcurrent=false) must have no clockExpr
#         triple. (SPARQL NOT EXISTS rule; ingestion-layer only — not OWL 2 DL
#         expressible, because absence of a triple cannot be asserted by
#         owl:Restriction under the Open World Assumption)
#
# IC-15: FactoryOverride.overrideScope = "instance" requires instancePath ≠ "".
#         (SPARQL rule)
#
# IC-16: RegField.msb < Register.registerWidth for all RegField triples.
#         (SPARQL arithmetic rule)
#
# IC-17: CoverPoint.optionAtLeast ≥ 1 (positiveInteger range).
#         (OWL 2 DL: rdfs:range xsd:positiveInteger already encodes ≥1)
#
# IC-18: No mixed clocking-block and direct driving of the same interface signals.
#         ∀d ∈ UVMDriver, i ∈ Interface, p ∈ Port:
#           drives(d,i) ∧ drives(d,p) ∧ portOf(p,i) ∧ hasClockingBlock(i,_) → VIOLATION
#         A driver that uses a CB path (drives→Interface) and also directly assigns to
#         a Port of that same interface bypasses clock-edge discipline, causing race
#         conditions at reset or during phase transitions. (SPARQL NOT EXISTS rule)
#
# IC-19: Zombie coverage — explicit-call CoverGroup with no SAMPLES edge.
#         ∀cg ∈ CoverGroup, samplingMechanism(cg)='explicit_call':
#           ∃sampler: samples(sampler,cg) → OK; else VIOLATION
#         A covergroup declared with explicit sampling but never called accumulates
#         zero bins and silently reports 0% coverage. (SPARQL NOT EXISTS rule)
#
# IC-20: Sequence-sampled coverage (warning, not fatal).
#         ∀cg ∈ CoverGroup: ∃seq ∈ UVMSequence: samples(seq,cg) → WARN
#         Coverage collected only inside a sequence is scope-limited: it is only
#         sampled when that sequence is active. Flag for review — may be intentional
#         but is frequently an oversight. (SPARQL rule)
#
# IC-21: Constraint override without activation (warning, not fatal).
#         ∀cb ∈ ConstraintBlock: overridesConstraint(cb,base_cb) ∧
#           ¬∃seq: randomizes(seq,item) ∧ hasConstraint(item,cb) → WARN
#         A constraint override defined in a derived class but never exercised
#         (no randomizes edge reaches an item with that constraint) suggests dead
#         test code or an incorrect class hierarchy. (SPARQL rule)
#
# ════════════════════════════════════════════════════════════════════════════
